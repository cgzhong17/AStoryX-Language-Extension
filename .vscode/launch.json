{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 AStoryX 扩展",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--user-data-dir=${workspaceFolder}/test/profiles/development",
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/examples/demo",
        "${workspaceFolder}/examples/demo/Stories/00_基础示例上.astoryx"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/out/**/*.js"
      ],
      "preLaunchTask": "AStoryX: compile"
    }
  ]
}
