{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "vscode"
    ],
    "rootDir": "..",
    "outDir": "../extension/out",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "../extension/node_modules/@types"
    ]
  },
  "include": [
    "../src/**/*.ts",
    "../test/**/*.ts"
  ],
  "exclude": [
    "../extension/node_modules",
    "../extension/out",
    "../test/profiles",
    "../test/extensions",
    "../test/tmp"
  ]
}
