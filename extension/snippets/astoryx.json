{
  "对话（真实 Tab）": { "prefix": ["dialog", "duihua"], "body": ["${1:人物}\t${2:台词}"], "description": "人物与台词之间插入真实制表符。" },
  "保护文段": { "prefix": ["protect", "baohu"], "body": "&{${1:包含斜杠或富文本的内容}}", "description": "保护内容，避免其中的分隔符被解析为参数。" },
  "别名区块": { "prefix": "aliases", "body": ["#aliases", "${1:素材名}->${2:显示名称}", "#endaliases"], "description": "别名方向沿用本地官方示例。" },
  "置换文块": { "prefix": "block", "body": ["#block ${1:文块名}(${2:参数})", "${3:内容}", "#endblock"], "description": "定义置换文块。" }
}
